{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "transit": {
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "apps/sim/.env",
        "apps/sim/.env.local",
        "apps/sim/.env.production",
        "apps/sim/.env.development"
      ],
      "outputs": [
        "packages/agent-contracts/dist/**",
        "packages/workflow-persistence/dist/**",
        "packages/workflow-types/dist/**",
        "packages/db/dist/**",
        "packages/auth/dist/**"
      ]
    },
    "topo": {
      "dependsOn": ["^topo"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build", "@sim/app#build:sandbox-bundles"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "@sim/app#build:sandbox-bundles": {
      "inputs": ["lib/execution/sandbox/bundles/**"],
      "outputs": ["lib/execution/sandbox/bundles/*.cjs"],
      "cache": true
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "start": {
      "cache": false
    },
    "type-check": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "format": {
      "outputs": []
    },
    "check": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["transit"],
      "outputs": ["coverage/**"]
    }
  }
}
